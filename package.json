{
  "name": "ts-http-server",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "bstart": "bun ./src/index.ts",
    "bdev": "bun --watch ./src/index.ts",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "npx tsc && node dist/index.js",
		"generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "5.0.6",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "express": "5.2.1",
    "postgres": "^3.4.9"
  }
}
