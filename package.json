{
  "name": "ts-http-server",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "bstart": "bun ./src/index.ts",
    "bdev": "bun --watch ./src/index.ts",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "npx tsc && node dist/index.js",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
		"test": "vitest --run"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "drizzle-kit": "0.31.10",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "typescript": "5"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "postgres": "3.4.9"
  }
}
